# UNDO Application Configuration
APP_NAME="UNDO Action Governance Engine"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# SQLite Persistence
DATABASE_URL="sqlite:///./undo.db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Planned AWS Bedrock Integration (Future Milestone)
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Planned MCP SDK Streamable HTTP Integration (Future Milestone)
MCP_SERVER_ENABLED=False
MCP_SERVER_PORT=8001
