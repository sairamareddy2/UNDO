# UNDO Application Configuration
APP_NAME="UNDO Action Governance Engine"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# SQLite Persistence
DATABASE_URL="sqlite:///./undo.db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google Gemini API Integration (Google AI Studio)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.1-flash-lite"

# Model Context Protocol (MCP) Streamable HTTP Server
MCP_SERVER_ENABLED=True
MCP_SERVER_PORT=8001
